# Email (reuse EMRG Google SMTP, or a dedicated expo mailbox)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EMRG Media <events@emrgmedia.com>

# Where new-order notifications go
EXPO_NOTIFY_EMAIL=jstewart@emrgmedia.com

# Stripe. Without STRIPE_SECRET_KEY the form still works but takes no payment,
# so the site is never broken while keys are pending.
#
# STRIPE_SECRET_KEY   sk_live_/sk_test_, or an rk_ restricted key scoped to
#                     write Checkout Sessions and read PaymentIntents.
# STRIPE_WEBHOOK_SECRET  whsec_..., from the webhook endpoint you create at
#                     <site>/api/stripe/webhook for checkout.session.completed.
#                     Receipts and confirmation emails only send once this is set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: pin the origin used for Stripe return URLs (defaults to the request origin)
# NEXT_PUBLIC_SITE_URL=https://booth.theeventplannerexpo.com

# Order tracker (Google Sheets). Without these the portal still works and just
# skips logging. Share the sheet with the service-account email as an Editor.
GOOGLE_SERVICE_ACCOUNT_KEY=
EXPO_LOG_SHEET_ID=
